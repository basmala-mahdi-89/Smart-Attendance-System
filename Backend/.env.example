# ==========================================
# Server Configuration
# ==========================================
PORT=5000

# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
# Get this from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# JWT Authentication
# ==========================================
# Change this to a strong random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# Email Service (Gmail App Password)
# ==========================================
# How to get App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ==========================================
# Frontend URL (For Invitations Links)
# ==========================================
# Change this to your Frontend IP/URL (e.g., http://192.168.1.10:5173)
FRONTEND_URL=http://localhost:5173